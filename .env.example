# Enables AI generation, the tutor, adaptive challenge questions, grading, and PDF reading.
# Without it, Synapse runs fully with its offline generator.
ANTHROPIC_API_KEY=

# Optional model override (defaults to claude-opus-5-5)
# SYNAPSE_MODEL=claude-opus-5-5

# Free alternative: run AI locally with Ollama (https://ollama.com) instead of Claude.
# SYNAPSE_AI_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_HOST=http://127.0.0.1:11434
